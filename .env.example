# ZAPI (https://app.z-api.io → sua instância)
ZAPI_INSTANCE_ID=SUA_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_SECURITY_TOKEN=SEU_SECURITY_TOKEN

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# WhatsApp do admin (recebe relatório diário)
ADMIN_PHONE=5511996554604

# Aplicação
SECRET_KEY=troque-por-uma-chave-segura
DATABASE_URL=sqlite:///./data/darkcred.db
UPLOAD_DIR=/app/uploads
BASE_URL=https://SEU_DOMINIO_OU_IP

# Limiar de aprovação automática (0.0 – 1.0)
# Comprovantes com confiança >= este valor são aprovados automaticamente
AUTO_APPROVE_THRESHOLD=0.85
